# Backend API base URL. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:8880/api/v1
# Public Google reCAPTCHA v2 site key. Leave blank for local development.
VITE_RECAPTCHA_SITE_KEY=
# URL của web frontend để Playwright mở khi chạy E2E. Có thể ghi đè bằng E2E_BASE_URL trên terminal/CI.
E2E_BASE_URL=http://localhost:5173
