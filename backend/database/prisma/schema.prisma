generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  admin
  manager
  receptionist
  coach
  member
}

enum account_status {
  pending_verification
  pending_approval
  active
  suspended
}

enum verification_channel {
  email
  phone
}

enum verification_purpose {
  registration
  staff_login
}

enum membership_status {
  pending_payment
  active
  expiring_soon
  expired
  frozen
  cancelled
}

enum entitlement_code {
  gym_access
  group_class_booking
  pool_access
  sauna_access
  towel_service
  premium_locker
  pt_session
}

enum entitlement_limit_period {
  weekly
  monthly
}

enum class_status {
  draft
  published
  cancelled
  completed
}

enum class_change_type {
  cancel
  reschedule
}

enum class_change_status {
  pending
  approved
  rejected
}

enum booking_status {
  confirmed
  waitlisted
  cancelled
  attended
  absent
}

enum facility_reservation_status {
  pending
  approved
  rejected
  cancelled
}

enum attendance_status {
  present
  absent
  late
  not_marked
}

enum payment_method {
  cash
  card
  bank_transfer
  online
}

enum payment_provider {
  momo
  zalopay
  bank
  payos
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum refund_status {
  pending
  approved
  rejected
}

enum support_status {
  open
  in_progress
  resolved
  closed
}

enum notification_category {
  member
  finance
  operations
  system
}

enum membership_reminder_type {
  pre_expiry
  grace
}

model roles {
  code               user_role @id
  label              String
  permission_version Int       @default(0)
}

model permissions {
  code        String @id @db.VarChar(150)
  description String
}

model role_permissions {
  role_code       user_role
  permission_code String @db.VarChar(150)
  @@id([role_code, permission_code])
}

model users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique
  password_hash String
  display_name  String
  role          user_role
  status        account_status @default(active)
  must_change_password Boolean @default(false)
  profile_setup_required Boolean @default(false)
  avatar_url    String?
  last_login_at DateTime?      @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)
}

model auth_sessions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, expires_at])
}

model auth_totp_factors {
  user_id           String   @id @db.Uuid
  secret_ciphertext String
  enrolled_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)
}

model auth_mfa_enrollments {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  secret_ciphertext String
  expires_at        DateTime @db.Timestamptz(6)
  consumed_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, expires_at])
}

model auth_mfa_login_challenges {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  login_surface String @default("main") @db.VarChar(16)
  expires_at DateTime @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, expires_at])
}

model account_verifications {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @db.Uuid
  channel     verification_channel
  purpose     verification_purpose @default(registration)
  code_hash   String
  expires_at  DateTime             @db.Timestamptz(6)
  verified_at DateTime?            @db.Timestamptz(6)
  attempts    Int                  @default(0)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)

  @@index([user_id, channel, purpose, created_at])
}

model staff_profiles {
  user_id      String   @id @db.Uuid
  employee_code String  @unique
  phone        String?  @unique
  date_of_birth DateTime? @db.Date
  notes        String?
  specialties  String[] @default([])
  hired_at     DateTime @default(now()) @db.Date
}

model members {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @unique @db.Uuid
  member_code   String   @unique
  full_name     String
  email         String?  @unique
  phone         String   @unique
  date_of_birth DateTime? @db.Date
  gender        String?
  joined_at     DateTime @default(now()) @db.Date
  created_by    String?  @db.Uuid
  approved_by   String?  @db.Uuid
  approved_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
}

model member_emergency_contacts {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id    String  @db.Uuid
  full_name    String
  relationship String
  phone        String
  is_primary   Boolean @default(true)
}

model membership_packages {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  name          String   @unique
  price_vnd     BigInt
  duration_days Int
  tier_rank     Int      @unique
  benefits      Json     @default("[]")
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
}

model membership_package_entitlements {
  package_id   String                   @db.Uuid
  entitlement  entitlement_code
  usage_limit  Int?
  limit_period entitlement_limit_period?
  @@id([package_id, entitlement])
}

model member_memberships {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id          String            @db.Uuid
  package_id         String            @db.Uuid
  package_name_snapshot String
  price_vnd_snapshot BigInt
  status             membership_status @default(pending_payment)
  starts_on          DateTime          @db.Date
  expires_on         DateTime          @db.Date
  contract_expires_at DateTime?        @db.Timestamptz(6)
  grace_expires_at    DateTime?        @db.Timestamptz(6)
  activated_at        DateTime?        @db.Timestamptz(6)
  activation_payment_id String?        @unique @db.Uuid
  frozen_days        Int               @default(0)
  auto_renew         Boolean           @default(false)
  created_by         String?           @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @updatedAt @db.Timestamptz(6)
}

model membership_freeze_requests {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_id String   @db.Uuid
  requested_by  String   @db.Uuid
  starts_on     DateTime @db.Date
  ends_on       DateTime @db.Date
  reason        String
  status        String   @default("pending")
  reviewed_by   String?  @db.Uuid
  reviewed_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model member_coach_assignments {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String    @db.Uuid
  coach_user_id String    @db.Uuid
  assigned_by   String?   @db.Uuid
  effective_from DateTime @default(now()) @db.Date
  effective_to   DateTime? @db.Date
  reason         String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model rooms {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String  @unique
  name      String  @unique
  capacity  Int
  is_active Boolean @default(true)
}

model class_sessions {
  pt_purchase_id String? @db.Uuid
  course_id        String? @db.Uuid
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique
  name          String
  description   String?
  type          String
  coach_user_id String       @db.Uuid
  room_id       String       @db.Uuid
  starts_at     DateTime     @db.Timestamptz(6)
  ends_at       DateTime     @db.Timestamptz(6)
  capacity      Int
  status        class_status @default(draft)
  created_by    String?      @db.Uuid
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
}

model class_change_requests {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_session_id String              @db.Uuid
  type             class_change_type
  proposed_starts_at DateTime?         @db.Timestamptz(6)
  proposed_ends_at DateTime?           @db.Timestamptz(6)
  reason           String
  status           class_change_status @default(pending)
  requested_by     String              @db.Uuid
  reviewed_by      String?             @db.Uuid
  reviewed_at      DateTime?           @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
}

model bookings {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_code     String         @unique
  member_id        String         @db.Uuid
  class_session_id String         @db.Uuid
  status           booking_status @default(confirmed)
  booked_by        String?        @db.Uuid
  booked_at        DateTime       @default(now()) @db.Timestamptz(6)
  cancelled_at     DateTime?      @db.Timestamptz(6)
  cancel_reason    String?
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
}

model attendance_records {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_session_id String            @db.Uuid
  member_id        String            @db.Uuid
  booking_id       String?           @unique @db.Uuid
  status           attendance_status @default(not_marked)
  checked_in_at    DateTime?         @db.Timestamptz(6)
  checked_out_at   DateTime?         @db.Timestamptz(6)
  recorded_by      String?           @db.Uuid
  recorded_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  @@unique([class_session_id, member_id])
}

model attendance_corrections {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id   String            @db.Uuid
  previous_status attendance_status
  new_status      attendance_status
  reason          String
  requested_by    String            @db.Uuid
  reviewed_by     String?           @db.Uuid
  reviewed_at     DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
}

model attendance_submissions {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_session_id String   @unique @db.Uuid
  submitted_by     String   @db.Uuid
  submitted_at     DateTime @default(now()) @db.Timestamptz(6)
}

model facility_checkins {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String   @db.Uuid
  membership_id String?  @db.Uuid
  checked_in_at DateTime @default(now()) @db.Timestamptz(6)
  recorded_by   String?  @db.Uuid
  allowed       Boolean
  denial_reason String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model facility_types {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model facilities {
  hourly_rate_vnd BigInt?
  room_id String? @unique @db.Uuid
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type_id      String   @db.Uuid
  name         String
  open_minute  Int
  close_minute Int
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  @@unique([type_id, name])
}

model facility_days {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id String   @db.Uuid
  open_on     DateTime @db.Date
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  @@unique([facility_id, open_on])
  @@index([open_on])
}

model facility_reservations {
  hourly_rate_vnd_snapshot BigInt?
  total_vnd_snapshot BigInt?
  payment_state String @default("legacy")
  activation_payment_id String? @db.Uuid
  completed_at DateTime? @db.Timestamptz(6)
  completed_by String? @db.Uuid
  completion_note String?
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day_id                 String                      @db.Uuid
  requester_user_id       String                      @db.Uuid
  requested_start_minute Int
  requested_end_minute   Int
  assigned_start_minute  Int?
  assigned_end_minute    Int?
  participant_count      Int
  contact_phone          String
  status                 facility_reservation_status @default(pending)
  requested_at           DateTime                    @default(now()) @db.Timestamptz(6)
  reviewed_by            String?                     @db.Uuid
  reviewed_at            DateTime?                   @db.Timestamptz(6)
  cancelled_by           String?                     @db.Uuid
  cancelled_at           DateTime?                   @db.Timestamptz(6)
  cancellation_requested_by String?                  @db.Uuid
  cancellation_requested_at DateTime?                @db.Timestamptz(6)
  cancellation_reason    String?
  decision_reason        String?
  @@index([requester_user_id, requested_at])
  @@index([requester_user_id, cancellation_requested_at])
  @@index([day_id, status])
  @@index([status, requested_at])
  @@index([cancellation_requested_at, status])
}

model payments {
  facility_reservation_id String? @db.Uuid
  pt_purchase_id String? @db.Uuid
  course_enrollment_id String? @db.Uuid
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_code String         @unique
  member_id        String         @db.Uuid
  membership_id    String?        @db.Uuid
  amount_vnd       BigInt
  method           payment_method
  provider         payment_provider?
  legacy_provider  String? @db.Text
  fulfillment_error String?
  provider_checkout_url String?
  provider_order_code BigInt? @unique
  status           payment_status @default(pending)
  recorded_by      String         @db.Uuid
  notes            String?
  paid_at          DateTime?      @db.Timestamptz(6)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
}

model payment_events {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id    String         @db.Uuid
  event_type    String
  previous_status payment_status?
  new_status    payment_status
  amount_vnd    BigInt
  actor_user_id String?        @db.Uuid
  note          String?
  occurred_at   DateTime       @default(now()) @db.Timestamptz(6)
}

model refund_requests {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refund_code  String        @unique
  payment_id   String        @db.Uuid
  member_id    String        @db.Uuid
  amount_vnd   BigInt
  reason       String
  status       refund_status @default(pending)
  requested_by String        @db.Uuid
  reviewed_by  String?       @db.Uuid
  reviewed_at  DateTime?     @db.Timestamptz(6)
  review_note  String?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt @db.Timestamptz(6)
}

model training_plans {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id         String   @db.Uuid
  coach_user_id     String   @db.Uuid
  name              String
  goal              String
  starts_on         DateTime @db.Date
  ends_on           DateTime @db.Date
  status            String
  coach_approved_at DateTime @default(now()) @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)
}

model training_plan_templates {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  target_group String
  description String?
  is_active   Boolean  @default(true)
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
}

model training_template_exercises {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id      String  @db.Uuid
  position         Int
  name             String
  sets             Int
  reps             Int?
  duration_seconds Int?
  rest_seconds     Int
  instructions     String?
  @@unique([template_id, position])
}

model training_plan_exercises {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id          String  @db.Uuid
  position         Int
  name             String
  sets             Int
  reps             Int?
  duration_seconds Int?
  rest_seconds     Int
  instructions     String?
  @@unique([plan_id, position])
}

model training_results {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id       String   @db.Uuid
  exercise_id   String?  @db.Uuid
  member_id     String   @db.Uuid
  recorded_by   String   @db.Uuid
  recorded_on   DateTime @db.Date
  value_numeric Decimal? @db.Decimal(12, 2)
  value_text    String?
  metric        String
  coach_comment String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model notifications {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_user_id String                @db.Uuid
  category          notification_category
  title             String
  body              String
  link_path         String?
  read_at           DateTime?             @db.Timestamptz(6)
  email_delivered_at DateTime?            @db.Timestamptz(6)
  email_skipped_at   DateTime?            @db.Timestamptz(6)
  email_delivery_attempts Int             @default(0)
  email_delivery_error String?
  email_delivery_locked_at DateTime?      @db.Timestamptz(6)
  created_at        DateTime              @default(now()) @db.Timestamptz(6)

  @@index([email_delivered_at, email_skipped_at, email_delivery_locked_at])
}

model ai_suggestion_deliveries {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_user_id   String   @db.Uuid
  member_id       String   @db.Uuid
  subject         String
  body            String
  reviewed_at     DateTime @default(now()) @db.Timestamptz(6)
  delivered_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([coach_user_id, delivered_at])
  @@index([member_id, delivered_at])
}

model training_sessions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id        String   @db.Uuid
  position       Int
  title          String
  scheduled_on   DateTime? @db.Date
  status         String   @default("pending")
  completed_at   DateTime? @db.Timestamptz(6)
  coach_comment  String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)
  @@unique([plan_id, position])
}

model training_session_exercises {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String   @db.Uuid
  position         Int
  name             String
  sets             Int
  reps             Int?
  duration_seconds Int?
  rest_seconds     Int
  instructions     String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)
  @@unique([session_id, position])
}

model notification_preferences {
  user_id      String   @id @db.Uuid
  email_enabled Boolean  @default(true)
  push_enabled  Boolean  @default(false)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
}

model membership_renewal_reminders {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_id   String                   @db.Uuid
  reminder_type   membership_reminder_type
  reminder_on     DateTime                 @db.Date
  sent_at         DateTime                 @default(now()) @db.Timestamptz(6)

  @@unique([membership_id, reminder_type, reminder_on])
  @@index([membership_id, reminder_on])
}

model support_tickets {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_code String         @unique
  member_id   String         @db.Uuid
  subject     String
  body        String
  status      support_status @default(open)
  priority    String
  assigned_to String?        @db.Uuid
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @updatedAt @db.Timestamptz(6)
}

model support_ticket_responses {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id      String   @db.Uuid
  author_user_id String   @db.Uuid
  body           String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model audit_logs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  entity_type   String
  entity_id     String?  @db.Uuid
  summary       String
  previous_value Json?
  new_value     Json?
  reason        String?
  occurred_at   DateTime @default(now()) @db.Timestamptz(6)
}

// Public-website content is separate from memberships, facilities, and bookings.
// Only a published revision referenced by site_page_publications is public.
model site_pages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  route_key  String   @unique @db.VarChar(80)
  path       String   @unique @db.VarChar(240)
  kind       String   @db.VarChar(16)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

model site_page_revisions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id         String   @db.Uuid
  version_number  Int
  edit_revision   Int      @default(1)
  status          String   @default("draft") @db.VarChar(16)
  title           String   @db.VarChar(240)
