{
  "name": "sports-center-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "worker:assets": "node scripts/prepare-worker-assets.mjs",
    "worker:dev": "npm run worker:assets && wrangler dev",
    "worker:build": "npm run worker:assets && wrangler deploy --dry-run",
    "predev": "prisma generate",
    "dev": "node --watch src/server.js",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "build": "node scripts/build-check.js",
    "backup:restore-verify": "node scripts/backup-restore-verify.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/migrate-with-retry.js",
    "admin:provision": "node scripts/provision-admin.mjs",
    "test:runtime-rate-limit": "node scripts/auth-rate-limit-runtime.js",
    "backup:verify": "node scripts/backup-restore-verify.js"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prisma": "^7.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.145.0"
  }
}
