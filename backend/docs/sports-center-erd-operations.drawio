<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Codex" version="27.0.0" type="device">
  <diagram id="erd-operations" name="03 - ERD vận hành">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="otitle" value="&lt;b&gt;ERD VẬN HÀNH — thanh toán, training, hỗ trợ và audit&lt;/b&gt;&lt;br&gt;PK = khóa chính · FK = khóa ngoại · đường liền crow’s-foot = 1–N · nét đứt = FK tùy chọn." style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1550" height="45" as="geometry"/></mxCell>
        <mxCell id="ouser" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;email, role, status&lt;br&gt;… (xem ERD lõi)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="omember" value="&lt;b&gt;members&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;member_code, full_name&lt;br&gt;… (xem ERD lõi)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ecfdf5;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="omembership" value="&lt;b&gt;member_memberships&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK member_id&lt;br&gt;pending_payment → active on paid&lt;br&gt;contract / grace access dates" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ecfdf5;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="235" height="112" as="geometry"/></mxCell>
        <mxCell id="payments" value="&lt;b&gt;payments&lt;/b&gt;&lt;br&gt;PK id · UQ transaction_code&lt;br&gt;FK member_id → members.id&lt;br&gt;FK membership_id → member_memberships.id (activation source)&lt;br&gt;amount_vnd, method, status&lt;br&gt;FK recorded_by → users.id&lt;br&gt;paid_at (revenue date when paid)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="events" value="&lt;b&gt;payment_events&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK payment_id → payments.id&lt;br&gt;event_type, previous_status, new_status&lt;br&gt;amount_vnd&lt;br&gt;FK actor_user_id → users.id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#fffbeb;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="870" y="210" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="refunds" value="&lt;b&gt;refund_requests (legacy)&lt;/b&gt;&lt;br&gt;PK id · UQ refund_code&lt;br&gt;FK payment_id → payments.id&lt;br&gt;FK member_id → members.id&lt;br&gt;Historical records only&lt;br&gt;New request disabled by policy" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f1f5f9;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="870" y="435" width="315" height="140" as="geometry"/></mxCell>
        <mxCell id="plans" value="&lt;b&gt;training_plans&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK member_id → members.id&lt;br&gt;FK coach_user_id → users.id&lt;br&gt;name, goal, status, dates" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f3e8ff;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="exercises" value="&lt;b&gt;training_plan_exercises&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK plan_id → training_plans.id&lt;br&gt;UQ plan_id + position&lt;br&gt;name, sets, reps, duration, rest" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#faf5ff;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="850" y="670" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="results" value="&lt;b&gt;training_results&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK plan_id → training_plans.id&lt;br&gt;FK exercise_id → exercises.id (nullable)&lt;br&gt;FK member_id, recorded_by → users/members&lt;br&gt;metric, values, comment" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#faf5ff;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="1280" y="670" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="notifications" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK recipient_user_id → users.id&lt;br&gt;category, title, body&lt;br&gt;link_path, read_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#e0f2fe;strokeColor=#0284c7;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="tickets" value="&lt;b&gt;support_tickets&lt;/b&gt;&lt;br&gt;PK id · UQ ticket_code&lt;br&gt;FK member_id → members.id&lt;br&gt;subject, body, status, priority&lt;br&gt;FK assigned_to → users.id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#e0f2fe;strokeColor=#0284c7;" vertex="1" parent="1"><mxGeometry x="850" y="950" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="responses" value="&lt;b&gt;support_ticket_responses&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK ticket_id → support_tickets.id&lt;br&gt;FK author_user_id → users.id&lt;br&gt;body, created_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f0f9ff;strokeColor=#0284c7;" vertex="1" parent="1"><mxGeometry x="1280" y="950" width="300" height="112" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;audit_logs&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK actor_user_id → users.id (nullable)&lt;br&gt;action, entity_type, entity_id&lt;br&gt;summary, previous_value, new_value&lt;br&gt;reason, occurred_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f1f5f9;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="1720" y="940" width="300" height="140" as="geometry"/></mxCell>
