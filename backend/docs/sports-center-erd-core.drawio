  <diagram id="erd-core" name="02 - ERD lõi">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="ctitle" value="&lt;b&gt;ERD LÕI — nhận diện, hội viên, lớp học, booking và attendance&lt;/b&gt;&lt;br&gt;PK = khóa chính · FK = khóa ngoại · đường liền crow’s-foot = 1–N · nét đứt = FK tùy chọn." style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="roles" value="&lt;b&gt;roles&lt;/b&gt;&lt;br&gt;PK code : user_role&lt;br&gt;label" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="185" height="82" as="geometry"/></mxCell>
        <mxCell id="permissions" value="&lt;b&gt;permissions&lt;/b&gt;&lt;br&gt;PK code : text&lt;br&gt;description" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="185" height="82" as="geometry"/></mxCell>
        <mxCell id="roleperms" value="&lt;b&gt;role_permissions&lt;/b&gt;&lt;br&gt;PK, FK role_code → roles.code&lt;br&gt;PK, FK permission_code → permissions.code" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="235" height="95" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;UQ email&lt;br&gt;password_hash, display_name&lt;br&gt;role, status, avatar_url&lt;br&gt;last_login_at, created_at, updated_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="staff" value="&lt;b&gt;staff_profiles&lt;/b&gt;&lt;br&gt;PK, FK user_id → users.id&lt;br&gt;UQ employee_code&lt;br&gt;specialties, hired_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#e0f2fe;strokeColor=#0284c7;" vertex="1" parent="1"><mxGeometry x="1010" y="85" width="235" height="98" as="geometry"/></mxCell>
        <mxCell id="members" value="&lt;b&gt;members&lt;/b&gt;&lt;br&gt;PK id : uuid&lt;br&gt;UQ, FK user_id → users.id (nullable)&lt;br&gt;UQ member_code, email, phone&lt;br&gt;full_name, DOB, gender, joined_at&lt;br&gt;FK created_by → users.id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ecfdf5;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="650" y="315" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="contacts" value="&lt;b&gt;member_emergency_contacts&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK member_id → members.id&lt;br&gt;full_name, relationship, phone&lt;br&gt;is_primary" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f0fdf4;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="1050" y="325" width="270" height="112" as="geometry"/></mxCell>
        <mxCell id="packages" value="&lt;b&gt;membership_packages&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;UQ code, name, tier_rank&lt;br&gt;price_vnd, duration_days&lt;br&gt;benefits, is_active" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#f0fdf4;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="250" height="112" as="geometry"/></mxCell>
        <mxCell id="memberships" value="&lt;b&gt;member_memberships&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;FK member_id → members.id&lt;br&gt;FK package_id → membership_packages.id&lt;br&gt;package_name_snapshot, price_snapshot&lt;br&gt;status: pending_payment → active / expired&lt;br&gt;starts_on, contract_expires_at, grace_expires_at&lt;br&gt;UQ FK activation_payment_id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="440" y="525" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="rooms" value="&lt;b&gt;rooms&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;UQ code, name&lt;br&gt;capacity, is_active" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="970" y="540" width="195" height="92" as="geometry"/></mxCell>
        <mxCell id="sessions" value="&lt;b&gt;class_sessions&lt;/b&gt;&lt;br&gt;PK id · UQ code&lt;br&gt;FK coach_user_id → users.id&lt;br&gt;FK room_id → rooms.id&lt;br&gt;name, type, starts_at, ends_at&lt;br&gt;capacity, status&lt;br&gt;FK created_by → users.id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="1290" y="510" width="290" height="155" as="geometry"/></mxCell>
        <mxCell id="bookings" value="&lt;b&gt;bookings&lt;/b&gt;&lt;br&gt;PK id · UQ booking_code&lt;br&gt;FK member_id → members.id&lt;br&gt;FK class_session_id → class_sessions.id&lt;br&gt;status, booked_at, cancelled_at&lt;br&gt;FK booked_by → users.id (nullable)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="700" y="790" width="300" height="140" as="geometry"/></mxCell>
