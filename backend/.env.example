# Neon connection string. Set the real value only in Render or a local .env file.
# Neon requires TLS; retain its sslmode/channel_binding query parameters.
DATABASE_URL="postgresql://neondb_owner:replace-with-neon-password@your-neon-host/neondb?sslmode=require&channel_binding=require"

# Optional: use a separate DB-owner URL for prisma migrate deploy.
MIGRATE_DATABASE_URL="postgresql://neondb_owner:replace-with-neon-password@your-neon-host/neondb?sslmode=require&channel_binding=require"

# HTTP server
NODE_ENV="development"
PORT="3000"
API_BASE_PATH="/api/v1"
CORS_ORIGIN="http://localhost:5173"

# Auth. Use unique production values in Render; never commit them.
AUTH_JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_SESSION_TTL_HOURS="8"
VERIFICATION_CODE_SECRET="replace-with-a-separate-random-secret-at-least-32-characters"
VERIFICATION_CODE_TTL_MINUTES="10"
VERIFICATION_DELIVERY_MODE="development"
